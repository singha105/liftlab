# Copy to .env (gitignored) and fill in. Used by `liftlab export-posthog` to pull events from PostHog.
# The front-end Project API key (phc_...) is public and is configured in app/ on Day 2, not here.
# The private API lives on the app host (us.posthog.com), not the ingestion host (us.i.posthog.com).
# The personal API key needs the query:read scope.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
